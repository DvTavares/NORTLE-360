# Copy this file to `.env` and replace the placeholders.

# Connection string for PostgreSQL. Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Secret used to sign the session cookie / login codes (HMAC). One per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me"

# ---------------------------------------------------------------------------
# SMTP — envio do código de confirmação de login por e-mail.
# Sem essas variáveis o app funciona em "modo dev": o código é impresso no
# console do servidor em vez de enviado.
# Exemplos: Gmail (senha de app), Zoho, Brevo, servidor da empresa, etc.
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NORTLE 360 <no-reply@seudominio.com.br>"
